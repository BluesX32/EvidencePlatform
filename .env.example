# Copy this file to .env and fill in the values before deploying.
#
# LOCAL DEV (docker compose up):
#   Only SECRET_KEY is strictly required. Everything else has safe defaults.
#
# AWS / PRODUCTION:
#   Set SECRET_KEY, BACKEND_CORS_ORIGINS, and ADMIN_SECRET before deploying.
#   Run:  cp .env.example .env  then edit .env

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-use-a-strong-random-key
ACCESS_TOKEN_EXPIRE_HOURS=24

# ── CORS ──────────────────────────────────────────────────────────────────────
# Browser origins allowed to call the backend directly.
# With the Vite proxy this only matters for Swagger UI (/docs) access.
# AWS example:  BACKEND_CORS_ORIGINS=http://1.2.3.4:5173
BACKEND_CORS_ORIGINS=http://localhost:5173

# ── Invite / Admin ────────────────────────────────────────────────────────────
# Set to false to allow open registration (local dev only).
INVITE_REQUIRED=true
# Secret for CLI admin access (POST /auth/admin/invite-codes with X-Admin-Secret header).
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(16))"
# Leave blank to use the in-app Admin panel instead.
ADMIN_SECRET=

# ── Email (optional) ─────────────────────────────────────────────────────────
# Leave SMTP_HOST blank to disable email sending (link is logged to console).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@evidenceplatform.local
SMTP_FROM_NAME=EvidencePlatform
FRONTEND_BASE_URL=http://localhost:5173

# ── Semantic Scholar (optional) ───────────────────────────────────────────────
# Free API key at https://www.semanticscholar.org/product/api (raises rate limit)
SEMANTIC_SCHOLAR_API_KEY=
